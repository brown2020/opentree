rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: only the user themselves can read/write their own doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    // Trees collection: only the owning user can access
    match /trees/{treeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Persons subcollection
      match /persons/{personId} {
        allow read: if request.auth != null && isTreeOwner(treeId);
        allow create: if request.auth != null && isTreeOwner(treeId)
          && request.resource.data.keys().hasAll(['firstName', 'lastName', 'gender', 'isLiving', 'createdAt', 'updatedAt'])
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
          && request.resource.data.gender in ['male', 'female', 'other', 'unknown']
          && request.resource.data.isLiving is bool;
        allow update: if request.auth != null && isTreeOwner(treeId);
        allow delete: if request.auth != null && isTreeOwner(treeId);

        // Photos subcollection
        match /photos/{photoId} {
          allow read: if request.auth != null && isTreeOwner(treeId);
          allow create: if request.auth != null && isTreeOwner(treeId)
            && request.resource.data.keys().hasAll(['url', 'storagePath', 'createdAt'])
            && request.resource.data.url is string
            && request.resource.data.storagePath is string;
          allow update: if request.auth != null && isTreeOwner(treeId);
          allow delete: if request.auth != null && isTreeOwner(treeId);
        }

        // Documents subcollection
        match /documents/{documentId} {
          allow read: if request.auth != null && isTreeOwner(treeId);
          allow create: if request.auth != null && isTreeOwner(treeId)
            && request.resource.data.keys().hasAll(['url', 'name', 'type', 'storagePath', 'fileSize', 'mimeType', 'createdAt'])
            && request.resource.data.name is string
            && request.resource.data.type in ['birth_certificate', 'death_certificate', 'marriage_certificate', 'census', 'military', 'immigration', 'other'];
          allow update: if request.auth != null && isTreeOwner(treeId);
          allow delete: if request.auth != null && isTreeOwner(treeId);
        }

        // Events subcollection
        match /events/{eventId} {
          allow read: if request.auth != null && isTreeOwner(treeId);
          allow create: if request.auth != null && isTreeOwner(treeId)
            && request.resource.data.keys().hasAll(['type', 'title', 'date', 'createdAt'])
            && request.resource.data.type in ['birth', 'death', 'marriage', 'divorce', 'graduation', 'immigration', 'military', 'occupation', 'residence', 'custom']
            && request.resource.data.title is string;
          allow update: if request.auth != null && isTreeOwner(treeId);
          allow delete: if request.auth != null && isTreeOwner(treeId);
        }

        // Relationships subcollection
        match /relationships/{relationshipId} {
          allow read: if request.auth != null && isTreeOwner(treeId);
          allow create: if request.auth != null && isTreeOwner(treeId)
            && request.resource.data.keys().hasAll(['type', 'relatedPersonId', 'createdAt'])
            && request.resource.data.type in ['parent', 'child', 'spouse', 'sibling'];
          allow update: if request.auth != null && isTreeOwner(treeId);
          allow delete: if request.auth != null && isTreeOwner(treeId);
        }
      }
    }

    // Helper function to check if the requesting user owns the tree
    function isTreeOwner(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data.userId == request.auth.uid;
    }
  }
}
