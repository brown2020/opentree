rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Default deny ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────
    match /users/{userId} {
      // Owner can read their own doc
      allow get: if isAuthenticated() && request.auth.uid == userId;

      // Email lookup for sharing invites — equality filter on email required
      allow list: if isAuthenticated()
        && request.query.limit <= 1
        && request.query.filters.size() == 1
        && request.query.filters[0].field.path.last() == 'email'
        && request.query.filters[0].op == '==';

      // Create own user doc on signup. Email must be the auth token email
      // (verification may still be pending; invite acceptance checks that separately).
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.email is string
        && tokenEmail().size() > 0
        && request.resource.data.email.lower() == tokenEmail()
        && request.resource.data.displayName is string;

      // Update own profile (display name, photo, updatedAt only)
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.email == resource.data.email;
    }

    // ── Trees ─────────────────────────────────────────────────────
    match /trees/{treeId} {

      // get by id: public trees for anyone; private trees for owner/members.
      // list: owner and members only, so isPublic cannot be used to enumerate every public tree.
      allow get: if resource.data.isPublic == true
        || (isAuthenticated() && (
          resource.data.userId == request.auth.uid
          || isMember(resource)
        ));

      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isMember(resource)
      );

      // Create: authenticated user, must set themselves as owner
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'name', 'isPublic', 'memberIds', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.isPublic is bool
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 0;

      // Owner can update anything except userId transfer
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // Invitee accepting a pending invite may add only themselves to memberIds
      allow update: if isAuthenticated()
        && hasPendingInvite(treeId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.isPublic == resource.data.isPublic
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.rootPersonId == resource.data.rootPersonId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'updatedAt'])
        && memberIdsAddsOnlySelf();

      // Editor members can only update safe fields
      allow update: if isAuthenticated()
        && isMember(resource)
        && hasEditorRole(treeId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.isPublic == resource.data.isPublic
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'rootPersonId', 'updatedAt']);

      // Only owner can delete
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // ── Members subcollection ─────────────────────────────────
      match /members/{memberId} {
        allow read: if canAccessCollaborationData(treeId);

        allow create: if isAuthenticated()
          && memberId == request.resource.data.userId
          && request.resource.data.keys().hasOnly(['userId', 'email', 'displayName', 'accessLevel', 'addedBy', 'addedAt'])
          && request.resource.data.accessLevel in ['editor', 'viewer']
          && request.resource.data.userId is string
          && request.resource.data.email is string
          && (request.resource.data.displayName == null
              || (request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 80))
          && (
            (isTreeOwner(treeId) && request.resource.data.addedBy == request.auth.uid)
            || isAcceptingPendingInvite(treeId, memberId)
          );

        allow update: if isAuthenticated()
          && isTreeOwner(treeId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.email == resource.data.email
          && request.resource.data.accessLevel in ['editor', 'viewer']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['accessLevel', 'displayName']);

        allow delete: if isAuthenticated() && isTreeOwner(treeId);
      }

      // ── Pending invites subcollection ───────────────────────────
      match /invites/{inviteId} {
        allow read: if isAuthenticated() && isTreeOwner(treeId);

        allow create: if isAuthenticated()
          && isTreeOwner(treeId)
          && inviteId == request.resource.data.email
          && request.resource.data.keys().hasAll(['email', 'accessLevel', 'addedBy', 'addedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.accessLevel in ['editor', 'viewer']
          && request.resource.data.addedBy == request.auth.uid;

        allow delete: if isAuthenticated() && (
          isTreeOwner(treeId)
          || (inviteId == canonicalUserEmail() && resource.data.email == canonicalUserEmail())
        );
      }

      // ── Activity subcollection ────────────────────────────────
      match /activity/{activityId} {
        allow read: if canAccessCollaborationData(treeId);

        allow create: if isAuthenticated()
          && canEditTree(treeId)
          && request.resource.data.keys().hasAll(['type', 'description', 'userId', 'timestamp'])
          && request.resource.data.type is string
          && request.resource.data.type.size() <= 50
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.userId == request.auth.uid;

        // Only owner can delete activity (cascade delete)
        allow delete: if isAuthenticated() && isTreeOwner(treeId);
      }

      // ── Relationships subcollection ───────────────────────────
      match /relationships/{relationshipId} {
        allow read: if canAccessTree(treeId);

        allow create: if isAuthenticated()
          && canEditTree(treeId)
          && request.resource.data.keys().hasAll(['type', 'person1Id', 'person2Id', 'createdAt'])
          && request.resource.data.type in ['parent-child', 'spouse']
          && request.resource.data.person1Id is string
          && request.resource.data.person2Id is string
          && request.resource.data.person1Id != request.resource.data.person2Id;

        allow update: if isAuthenticated()
          && canEditTree(treeId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.person1Id == resource.data.person1Id
          && request.resource.data.person2Id == resource.data.person2Id;

        allow delete: if isAuthenticated() && canEditTree(treeId);
      }

      // ── Persons subcollection ─────────────────────────────────
      // Public documents store name, gender, and isLiving only.
      // Dates, places, bio, and photo URL live in restricted/profile.
      match /persons/{personId} {
        allow read: if canViewSensitive(treeId)
          || (canAccessTree(treeId) && (
            resource.data.isLiving == false
            || !personHasSensitiveFields(resource.data)
          ));

        allow create: if isAuthenticated()
          && canEditTree(treeId)
          && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'gender', 'isLiving', 'createdAt', 'updatedAt'])
          && validPublicPerson(request.resource.data);

        allow update: if isAuthenticated()
          && canEditTree(treeId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['firstName', 'lastName', 'gender', 'isLiving', 'updatedAt'])
              && validPublicPerson(request.resource.data)
              && !personHasSensitiveFields(request.resource.data)
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'middleName', 'maidenName', 'birthDate', 'birthPlace',
                'deathDate', 'deathPlace', 'bio', 'profilePhotoUrl', 'updatedAt'
              ])
              && !personHasSensitiveFields(request.resource.data)
              && request.resource.data.firstName == resource.data.firstName
              && request.resource.data.lastName == resource.data.lastName
              && request.resource.data.gender == resource.data.gender
              && request.resource.data.isLiving == resource.data.isLiving
            )
          );
        allow delete: if isAuthenticated() && canEditTree(treeId);

        match /restricted/{docId} {
          allow get: if docId == 'profile' && canReadPersonContent(treeId, personId);
          allow list: if false;

          allow create, update: if isAuthenticated()
            && canEditTree(treeId)
            && docId == 'profile'
            && validRestrictedProfile(request.resource.data);

          allow delete: if isAuthenticated()
            && canEditTree(treeId)
            && docId == 'profile';
        }

        // ── Photos ────────────────────────────────────────────
        match /photos/{photoId} {
          allow read: if canReadPersonContent(treeId, personId);

          allow create: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.keys().hasAll(['url', 'storagePath', 'createdAt'])
            && request.resource.data.url is string
            && request.resource.data.url.size() <= 2048
            && request.resource.data.storagePath is string
            && request.resource.data.storagePath.size() <= 500;

          allow update: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.url == resource.data.url
            && request.resource.data.storagePath == resource.data.storagePath;

          allow delete: if isAuthenticated() && canEditTree(treeId);
        }

        // ── Documents ─────────────────────────────────────────
        match /documents/{documentId} {
          allow read: if canReadPersonContent(treeId, personId);

          allow create: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.keys().hasAll(['url', 'name', 'type', 'storagePath', 'fileSize', 'mimeType', 'createdAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 255
            && request.resource.data.type in ['birth_certificate', 'death_certificate', 'marriage_certificate', 'census', 'military', 'immigration', 'other']
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0;

          allow update: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.url == resource.data.url
            && request.resource.data.storagePath == resource.data.storagePath;

          allow delete: if isAuthenticated() && canEditTree(treeId);
        }

        // ── Events (timeline) ─────────────────────────────────
        match /events/{eventId} {
          allow read: if canReadPersonContent(treeId, personId);

          allow create: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.keys().hasAll(['type', 'title', 'date', 'createdAt'])
            && request.resource.data.type in ['birth', 'death', 'marriage', 'divorce', 'graduation', 'immigration', 'military', 'occupation', 'residence', 'custom']
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 1
            && request.resource.data.title.size() <= 200;

          allow update: if isAuthenticated()
            && canEditTree(treeId)
            && request.resource.data.type in ['birth', 'death', 'marriage', 'divorce', 'graduation', 'immigration', 'military', 'occupation', 'residence', 'custom'];

          allow delete: if isAuthenticated() && canEditTree(treeId);
        }
      }
    }

    // Collection group: resolve pending invites for the authenticated user
    match /{path=**}/invites/{inviteId} {
      allow read, delete: if isAuthenticated()
        && resource.data.email == canonicalUserEmail();
    }

    // ── Helper functions ──────────────────────────────────────────

    function isAuthenticated() {
      return request.auth.uid != null;
    }

    function isMember(treeResource) {
      return treeResource.data.memberIds is list
        && request.auth.uid in treeResource.data.memberIds;
    }

    function isTreeOwner(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId)).data.userId == request.auth.uid;
    }

    function canAccessTree(treeId) {
      let tree = get(/databases/$(database)/documents/trees/$(treeId)).data;
      return tree.isPublic == true
        || (isAuthenticated() && (
          tree.userId == request.auth.uid
          || (tree.memberIds is list && request.auth.uid in tree.memberIds)
        ));
    }

    function isTreeMember(treeId) {
      let tree = get(/databases/$(database)/documents/trees/$(treeId)).data;
      return isAuthenticated()
        && tree.memberIds is list
        && request.auth.uid in tree.memberIds;
    }

    function canAccessCollaborationData(treeId) {
      return isTreeOwner(treeId) || isTreeMember(treeId);
    }

    function canViewSensitive(treeId) {
      let tree = get(/databases/$(database)/documents/trees/$(treeId)).data;
      return isAuthenticated() && (
        tree.userId == request.auth.uid
        || (
          tree.memberIds is list
          && request.auth.uid in tree.memberIds
          && (tree.isPublic != true || hasEditorRole(treeId))
        )
      );
    }

    function personHasSensitiveFields(data) {
      return data.keys().hasAny([
        'middleName', 'maidenName', 'birthDate', 'birthPlace',
        'deathDate', 'deathPlace', 'bio', 'profilePhotoUrl'
      ]);
    }

    function canReadPersonContent(treeId, personId) {
      let person = get(/databases/$(database)/documents/trees/$(treeId)/persons/$(personId)).data;
      return canViewSensitive(treeId)
        || (canAccessTree(treeId) && person.isLiving == false);
    }

    function validPublicPerson(data) {
      return data.firstName is string
        && data.firstName.size() >= 1
        && data.firstName.size() <= 100
        && data.lastName is string
        && data.lastName.size() >= 1
        && data.lastName.size() <= 100
        && data.gender in ['male', 'female', 'other', 'unknown']
        && data.isLiving is bool;
    }

    function optionalString(data, key, maxLen) {
      return !data.keys().hasAny([key])
        || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function optionalTimestamp(data, key) {
      return !data.keys().hasAny([key])
        || data[key] == null
        || data[key] is timestamp;
    }

    function validRestrictedProfile(data) {
      return data.keys().hasOnly([
          'middleName', 'maidenName', 'birthDate', 'birthPlace',
          'deathDate', 'deathPlace', 'bio', 'profilePhotoUrl', 'updatedAt'
        ])
        && optionalString(data, 'middleName', 100)
        && optionalString(data, 'maidenName', 100)
        && optionalString(data, 'birthPlace', 200)
        && optionalString(data, 'deathPlace', 200)
        && optionalString(data, 'bio', 2000)
        && optionalString(data, 'profilePhotoUrl', 2048)
        && optionalTimestamp(data, 'birthDate')
        && optionalTimestamp(data, 'deathDate');
    }

    function canEditTree(treeId) {
      let tree = get(/databases/$(database)/documents/trees/$(treeId)).data;
      return tree.userId == request.auth.uid
        || (tree.memberIds is list
            && request.auth.uid in tree.memberIds
            && hasEditorRole(treeId));
    }

    function hasEditorRole(treeId) {
      let member = get(/databases/$(database)/documents/trees/$(treeId)/members/$(request.auth.uid)).data;
      return member.accessLevel == 'editor';
    }

    // New memberIds must be the previous list plus the caller, and nothing else.
    function memberIdsAddsOnlySelf() {
      return resource.data.memberIds is list
        && request.resource.data.memberIds is list
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds);
    }

    // Auth token is the only authority for email. A user document email is
    // client-written and must not be used to accept or read invites.
    function tokenEmail() {
      return request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function canonicalUserEmail() {
      return request.auth.token.email_verified == true
        ? tokenEmail()
        : '';
    }

    function hasPendingInvite(treeId) {
      let email = canonicalUserEmail();
      return email.size() > 0
        && exists(/databases/$(database)/documents/trees/$(treeId)/invites/$(email));
    }

    function isAcceptingPendingInvite(treeId, memberId) {
      let email = canonicalUserEmail();
      return memberId == request.auth.uid
        && hasPendingInvite(treeId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == email
        && request.resource.data.accessLevel
            == get(/databases/$(database)/documents/trees/$(treeId)/invites/$(email)).data.accessLevel
        && request.resource.data.addedBy
            == get(/databases/$(database)/documents/trees/$(treeId)/invites/$(email)).data.addedBy;
    }
  }
}
