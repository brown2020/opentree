rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Default deny ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── Profile photos: users/{userId}/profile/{fileName} ───────
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|svg\\+xml)')
        && !fileName.matches('.*\\.\\.');

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|svg\\+xml)');

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // ── Tree media: users/{ownerId}/trees/{treeId}/persons/{personId}/{type}/{fileName}
    match /users/{ownerId}/trees/{treeId}/persons/{personId}/{type}/{fileName} {

      allow read: if canAccessTreeMedia(treeId, ownerId);

      allow create: if request.auth != null
        && canEditTreeMedia(treeId, ownerId)
        && !fileName.matches('.*\\.\\.')
        && validateMediaFile(type);

      allow update: if request.auth != null
        && canEditTreeMedia(treeId, ownerId)
        && validateMediaFile(type);

      allow delete: if request.auth != null
        && canEditTreeMedia(treeId, ownerId);
    }

    function canAccessTreeMedia(treeId, ownerId) {
      let tree = firestore.get(/databases/(default)/documents/trees/$(treeId)).data;
      return tree.isPublic == true
        || (request.auth != null && (
          request.auth.uid == ownerId
          || (tree.memberIds is list && request.auth.uid in tree.memberIds)
        ));
    }

    function canEditTreeMedia(treeId, ownerId) {
      return request.auth.uid == ownerId
        || (firestore.get(/databases/(default)/documents/trees/$(treeId)).data.memberIds is list
            && request.auth.uid in firestore.get(/databases/(default)/documents/trees/$(treeId)).data.memberIds
            && firestore.get(/databases/(default)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.role == 'editor');
    }

    function validateMediaFile(type) {
      return (type == 'photos'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|svg\\+xml|heic|heif)'))
      || (type == 'documents'
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
            || request.resource.contentType == 'application/pdf'));
    }
  }
}
