rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Default deny ────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── Profile photos: users/{userId}/profile/{fileName} ───────
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth.uid != null && request.auth.uid == userId;

      allow create: if request.auth.uid != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|gif|webp)$')
        && !fileName.matches('.*\\.\\.');

      allow update: if request.auth.uid != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|gif|webp)$');

      allow delete: if request.auth.uid != null
        && request.auth.uid == userId;
    }

    // ── Tree media: users/{ownerId}/trees/{treeId}/persons/{personId}/{type}/{fileName}
    match /users/{ownerId}/trees/{treeId}/persons/{personId}/{type}/{fileName} {

      allow read: if canReadPersonMedia(treeId, personId, ownerId);

      allow create: if request.auth.uid != null
        && canEditTreeMedia(treeId, ownerId)
        && !fileName.matches('.*\\.\\.')
        && validateMediaFile(type);

      allow update: if request.auth.uid != null
        && canEditTreeMedia(treeId, ownerId)
        && validateMediaFile(type);

      allow delete: if request.auth.uid != null
        && canEditTreeMedia(treeId, ownerId);
    }

    function treeData(treeId) {
      return firestore.get(/databases/(default)/documents/trees/$(treeId)).data;
    }

    function personData(treeId, personId) {
      return firestore.get(/databases/(default)/documents/trees/$(treeId)/persons/$(personId)).data;
    }

    function isEditor(treeId) {
      return request.auth.uid != null
        && treeData(treeId).memberIds is list
        && request.auth.uid in treeData(treeId).memberIds
        && firestore.get(/databases/(default)/documents/trees/$(treeId)/members/$(request.auth.uid)).data.accessLevel == 'editor';
    }

    // Owner, public-tree editors, and every member of a private tree.
    function canViewSensitive(treeId) {
      let tree = treeData(treeId);
      return request.auth.uid != null && (
        tree.userId == request.auth.uid
        || isEditor(treeId)
        || (tree.isPublic != true
            && tree.memberIds is list
            && request.auth.uid in tree.memberIds)
      );
    }

    // Path owner must be the tree owner. Living-person files stay private on public trees.
    function canReadPersonMedia(treeId, personId, ownerId) {
      let tree = treeData(treeId);
      let person = personData(treeId, personId);
      return tree.userId == ownerId && (
        canViewSensitive(treeId)
        || (person.isLiving == false && (
          tree.isPublic == true
          || (request.auth.uid != null && (
            request.auth.uid == tree.userId
            || (tree.memberIds is list && request.auth.uid in tree.memberIds)
          ))
        ))
      );
    }

    function canEditTreeMedia(treeId, ownerId) {
      let tree = treeData(treeId);
      return request.auth.uid != null
        && tree.userId == ownerId
        && (request.auth.uid == ownerId || isEditor(treeId));
    }

    function validateMediaFile(type) {
      return (type == 'photos'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|gif|webp|heic|heif)$'))
      || (type == 'documents'
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('^image/(jpeg|png|gif|webp)$')
            || request.resource.contentType == 'application/pdf'));
    }
  }
}
